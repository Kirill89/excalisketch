{
  "name": "excalisketch",
  "version": "1.6.1",
  "description": "Local Excalidraw editor for a single file — edit in your browser while an AI agent (or any tool) edits the same file on disk, with live two-way sync.",
  "type": "module",
  "bin": {
    "excalisketch": "bin/cli.js"
  },
  "files": [
    "bin/",
    "tools/",
    "assets/",
    "server.js",
    "public/index.html",
    "public/bundle.js",
    "public/bundle.css",
    "public/export.mjs",
    "public/fonts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "render:docs": "node bin/cli.js tool render docs/how-it-works.excalidraw --out docs/how-it-works.png",
    "ui": "node build.mjs && node bin/cli.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "node build.mjs"
  },
  "keywords": [
    "excalidraw",
    "editor",
    "diagram",
    "cli",
    "ai",
    "agent",
    "local"
  ],
  "author": "Kirill <kirill89@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Kirill89/excalisketch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kirill89/excalisketch.git"
  },
  "bugs": {
    "url": "https://github.com/Kirill89/excalisketch/issues"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@viz-js/viz": "^3.29.0",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "open": "^11.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@excalidraw/excalidraw": "^0.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
